# AegisShield — local development configuration
#
# Copy this file to .env before the first start:
#
#     cp .env.example .env
#
# .env is git-ignored and is read by Docker Compose for interpolation only.
# Every value below is development-grade and localhost-only; none is a secret.
#
# Credentials freeze when the corresponding named volume is initialized.
# Changing one later does not re-provision the account — discard the volume
# with `docker compose down -v` first.

# --- PostgreSQL ---------------------------------------------------------
# Owning account for the application database; read by the postgres image
POSTGRES_USER=aegis
# Password for that account; read by the postgres image
POSTGRES_PASSWORD=aegis_dev_password
# Application database, created empty on first start; read by the postgres image
POSTGRES_DB=aegisshield
# Host port the database is published on; read by Compose interpolation
POSTGRES_PORT=5432

# --- RabbitMQ -----------------------------------------------------------
# Administrative account, replaces the stock guest account; read by the rabbitmq image
RABBITMQ_DEFAULT_USER=aegis
# Password for that account and for the management interface; read by the rabbitmq image
RABBITMQ_DEFAULT_PASS=aegis_dev_password
# Virtual host created on first start; read by the rabbitmq image
RABBITMQ_DEFAULT_VHOST=aegisshield
# Host port for the messaging endpoint; read by Compose interpolation
RABBITMQ_PORT=5672
# Host port for the web management interface; read by Compose interpolation
RABBITMQ_MANAGEMENT_PORT=15672
