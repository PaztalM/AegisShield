# AegisShield — local development configuration
#
# Copy this file to .env before the first start:
#
#     cp .env.example .env
#
# .env is git-ignored and is read by Docker Compose for interpolation only.
# Every value below is development-grade and localhost-only; none is a secret.
#
# Credentials freeze when the corresponding named volume is initialized.
# Changing one later does not re-provision the account — discard the volume
# with `docker compose down -v` first.

# --- PostgreSQL ---------------------------------------------------------
# Owning account for the application database; read by the postgres image
POSTGRES_USER=aegis
# Password for that account; read by the postgres image
POSTGRES_PASSWORD=aegis_dev_password
# Application database, created empty on first start; read by the postgres image
POSTGRES_DB=aegisshield
# Host port the database is published on; read by Compose interpolation
POSTGRES_PORT=5432

# --- RabbitMQ -----------------------------------------------------------
# Administrative account, replaces the stock guest account; read by the rabbitmq image
RABBITMQ_DEFAULT_USER=aegis
# Password for that account and for the management interface; read by the rabbitmq image
RABBITMQ_DEFAULT_PASS=aegis_dev_password
# Virtual host created on first start; read by the rabbitmq image
RABBITMQ_DEFAULT_VHOST=aegisshield
# Host port for the messaging endpoint; read by Compose interpolation
RABBITMQ_PORT=5672
# Host port for the web management interface; read by Compose interpolation
RABBITMQ_MANAGEMENT_PORT=15672

# --- Service connections (feature 002) -----------------------------------
# Internal DNS names on the Compose network. These are the service names, so
# they will not normally vary; overridable so a service can be pointed
# somewhere else without editing docker-compose.yml.
# NOTE: the new services reach the broker and database on their INTERNAL
# ports 5672 and 5432, never RABBITMQ_PORT / POSTGRES_PORT above. Those
# publish to the host and a developer may relocate them to clear a port
# conflict; a service inside the network that used the host-side port would
# break the moment that happened.
# Broker hostname; read by producer, worker, tests
RABBITMQ_HOST=rabbitmq
# Database hostname; read by worker, tests
POSTGRES_HOST=postgres

# --- Producer ------------------------------------------------------------
# Transactions generated per second; read by producer
# Kept modest so the default experience is readable in `docker compose logs`
# rather than a blur. The 50/second target is what the system must sustain,
# not what it runs at by default.
PRODUCER_RATE_PER_SECOND=5
# Fraction of transactions built to be obviously fraudulent; read by producer
# Exists so the rules can be watched working rather than taken on trust.
PRODUCER_FRAUD_RATIO=0.1
# How many distinct account identifiers to draw from; read by producer
# Small on purpose: it is what makes several transactions land on one account
# inside the velocity window, so that rule fires without special-casing.
# Raising this suppresses velocity flags.
PRODUCER_ACCOUNT_POOL_SIZE=20

# --- Worker (fraud rules) ------------------------------------------------
# Amount above which a transaction is flagged, STRICTLY greater; read by worker
# Exactly 5000.00 is NOT flagged.
FRAUD_AMOUNT_THRESHOLD=5000.00
# Transactions on one account within the window needed to flag; read by worker
# Counts the transaction being decided, so 3 prior plus this one flags.
FRAUD_VELOCITY_COUNT=4
# Length of the velocity window in seconds; read by worker
# Half-open: a prior transaction exactly this old is outside it.
FRAUD_VELOCITY_WINDOW_SECONDS=60

# --- Both new services (operational) -------------------------------------
# Logging level; read by producer, worker
LOG_LEVEL=INFO
# Ceiling on the exponential backoff used when reconnecting to a dependency;
# read by producer, worker. There is no attempt limit: the services retry
# forever rather than exiting, which the constitution requires.
RETRY_MAX_DELAY_SECONDS=30
# File each service touches on every loop iteration; read by producer, worker
# Its freshness is what the Compose healthcheck checks, so the check reports
# "the loop is still turning" rather than "the process exists".
HEARTBEAT_FILE=/tmp/heartbeat
# How stale that file may be before the service is reported unhealthy;
# read by the healthchecks in docker-compose.yml
# Must be comfortably longer than one loop iteration at the slowest
# configured rate, or a healthy service gets reported unhealthy.
HEARTBEAT_MAX_AGE_SECONDS=30

